# ─────────────────────────────────────────────────────────────────────────────
# RTP Dhol Crew — environment configuration
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else
# is server-only and is read exclusively from files marked `server-only`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL (used for SEO canonicals, emails, Stripe redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA time zone the business operates in. All event times are interpreted here.
NEXT_PUBLIC_BUSINESS_TIMEZONE=America/New_York

# ── Supabase ─────────────────────────────────────────────────────────────────
# Without these the public site renders from built-in sample content and the
# admin dashboard shows a setup screen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used only after server-side validation.
SUPABASE_SERVICE_ROLE_KEY=
# Storage buckets (created by migrations).
SUPABASE_MEDIA_BUCKET=media
SUPABASE_DOCUMENTS_BUCKET=documents

# ── Security ─────────────────────────────────────────────────────────────────
# 32+ random characters. Used to derive HMAC keys for magic-link tokens and
# the cron endpoint. Generate with: openssl rand -base64 48
APP_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/* (Vercel sets CRON_SECRET automatically when configured).
CRON_SECRET=
# Comma-separated emails that are promoted to `owner` on first sign-in.
ADMIN_BOOTSTRAP_EMAILS=
# Store the signer IP address on contract signatures (true/false). Check local law.
CONTRACT_STORE_SIGNER_IP=true

# ── Stripe ───────────────────────────────────────────────────────────────────
# Without these, "Pay deposit" shows a "payments not configured" state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: statement descriptor suffix shown on card statements (max 22 chars).
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=RTP DHOL CREW

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are written to the communication log with
# status "logged" instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="RTP Dhol Crew <bookings@rtpdholcrew.com>"
EMAIL_REPLY_TO=bookings@rtpdholcrew.com
# Where admin notifications (new lead, contract signed, deposit paid) go.
ADMIN_NOTIFICATION_EMAIL=

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Without these, SMS messages are logged only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional Messaging Service SID (takes precedence over TWILIO_FROM_NUMBER).
TWILIO_MESSAGING_SERVICE_SID=

# ── AI ───────────────────────────────────────────────────────────────────────
# anthropic | openai | none. With "none" (or no key) agents use deterministic
# rule-based output so every workflow still functions.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── Calendar ─────────────────────────────────────────────────────────────────
# ics | google. "ics" works with no credentials (downloadable .ics + feed).
CALENDAR_PROVIDER=ics
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key with literal \n sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Media ────────────────────────────────────────────────────────────────────
# Optional hero reel (MP4/WebM, ideally < 4 MB, 720p). Poster is always shown first.
NEXT_PUBLIC_HERO_VIDEO_URL=
